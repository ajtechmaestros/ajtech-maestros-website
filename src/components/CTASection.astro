---
import Button from './Button.astro';
import { whatsappLink } from '../site.config';

interface Props {
  label?: string;
  title: string;
  description?: string;
  whatsappMessage?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  large?: boolean;
}
const { label, title, description, whatsappMessage, secondaryHref, secondaryLabel, large = false } = Astro.props;
---
<section class="border-t border-divider pt-12 pb-16">
  {label && <span class="kicker mb-3">{label}</span>}
  <h2 class:list={['h2', large && 'h2-lg']}>{title}</h2>
  {description && <p class="lead mt-4 max-w-[50ch] text-[16px]">{description}</p>}
  <div class="btn-row mt-7">
    <Button href={whatsappLink(whatsappMessage)}>WhatsApp Us</Button>
    {secondaryHref && secondaryLabel && <Button href={secondaryHref} variant="ghost">{secondaryLabel}</Button>}
  </div>
</section>
