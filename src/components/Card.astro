---
interface Props { kicker?: string; title?: string; lift?: boolean; class?: string; }
const { kicker, title, lift = true, class: className = '' } = Astro.props;
---
<div class:list={['card', lift && 'card-lift', className]}>
  {kicker && <div class="card-kicker">{kicker}</div>}
  {title && <h3 class="card-title">{title}</h3>}
  <p class="card-body"><slot /></p>
</div>
