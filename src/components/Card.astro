---
import Corners from './Corners.astro';

interface Props { kicker?: string; title?: string; class?: string; }
const { kicker, title, class: className = '' } = Astro.props;
---
<div class:list={['card blueprint', className]}>
  <Corners />
  <slot name="photo" />
  {kicker && <div class="card-kicker">{kicker}</div>}
  {title && <h3 class="card-title">{title}</h3>}
  <p class="card-body"><slot /></p>
</div>
