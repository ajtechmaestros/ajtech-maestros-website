---
interface Props { title: string; description: string; code?: string; href?: string; points?: string[]; }
const { title, description, code = 'AJ', href, points = [] } = Astro.props;
const Tag = href ? 'a' : 'article';
---
<Tag href={href} class="group block h-full rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm shadow-neutral-950/[0.03] transition hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-neutral-950/[0.08]">
  <div class="flex items-start justify-between gap-4">
    <span class="grid size-12 place-items-center rounded-xl bg-ink text-sm font-black text-white transition group-hover:bg-accent">{code}</span>
    <span class="mt-1 h-1.5 w-12 rounded-full bg-accent/25 transition group-hover:bg-accent"></span>
  </div>
  <h3 class="mt-6 text-xl font-black tracking-tight text-ink">{title}</h3>
  <p class="mt-3 text-sm leading-6 text-neutral-600">{description}</p>
  {points.length > 0 && <ul class="mt-5 grid gap-2 text-sm font-medium text-neutral-700">{points.map((point) => <li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent"></span><span>{point}</span></li>)}</ul>}
</Tag>
