---
interface Props {
  src?: string;
  alt: string;
  ratio?: string;
  shadow?: boolean;
  eager?: boolean;
  class?: string;
}
const { src, alt, ratio = '3 / 2', shadow = true, eager = false, class: className = '' } = Astro.props;
---
<figure class:list={['photo', shadow && 'photo-shadow', className]} style={`aspect-ratio:${ratio};`}>
  {src ? (
    <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="photo-empty" role="img" aria-label={alt}>Photo coming soon</div>
  )}
</figure>
