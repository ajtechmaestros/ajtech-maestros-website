---
import Corners from './Corners.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  block?: boolean;
  class?: string;
}
const { href, variant = 'primary', type = 'button', block = false, class: className = '' } = Astro.props;
const primary = variant === 'primary';
const external = href?.startsWith('http');
const classes = ['btn', `btn-${variant}`, primary && 'blueprint', block && 'btn-block', className];
---
{href ? (
  <a href={href} class:list={classes} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{primary && <Corners />}<slot /></a>
) : (
  <button type={type} class:list={classes}>{primary && <Corners />}<slot /></button>
)}
