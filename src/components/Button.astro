---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'outline-light';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit' | 'reset';
  block?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', type = 'button', block = false, class: className = '' } = Astro.props;
const external = href?.startsWith('http');
const classes = ['btn', `btn-${variant}`, size === 'sm' && 'btn-sm', block && 'btn-block', className];
---
{href ? (
  <a href={href} class:list={classes} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}><slot /></a>
) : (
  <button type={type} class:list={classes}><slot /></button>
)}
