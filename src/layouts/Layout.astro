---
import '../styles/global.css';
import { navItems, siteConfig, whatsappUrl } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} | ${siteConfig.tagline}`,
  description = siteConfig.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1115" />
    <title>{title}</title>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0f1115]/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-[#ff7a00] font-black text-black">AJ</span>
          <div class="leading-tight">
            <div class="font-bold tracking-wide">AJ Tech Maestros</div>
            <div class="text-xs uppercase tracking-[0.2em] text-white/50">Design. Engineer. Create.</div>
          </div>
        </a>

        <nav class="hidden items-center gap-6 text-sm text-white/75 lg:flex">
          {navItems.map((item) => <a class="transition hover:text-[#ff7a00]" href={item.href}>{item.label}</a>)}
        </nav>

        <a href={whatsappUrl} class="rounded-full bg-[#ff7a00] px-4 py-2 text-sm font-semibold text-black transition hover:brightness-110">
          WhatsApp
        </a>
      </div>
    </header>

    <main><slot /></main>

    <footer class="border-t border-white/10 bg-black/20">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3 lg:px-8">
        <div>
          <div class="text-lg font-bold">AJ Tech Maestros</div>
          <p class="mt-3 max-w-md text-sm leading-6 text-white/60">{siteConfig.description}</p>
        </div>
        <div>
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-white/50">Contact</div>
          <div class="mt-3 space-y-2 text-sm text-white/70">
            <div>{siteConfig.email}</div>
            <div>{siteConfig.phone}</div>
            <div>{siteConfig.location}</div>
          </div>
        </div>
        <div>
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-white/50">Company</div>
          <div class="mt-3 space-y-2 text-sm text-white/70">
            <div>{siteConfig.legalName}</div>
            <div>Engineering • Design • Fabrication</div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
