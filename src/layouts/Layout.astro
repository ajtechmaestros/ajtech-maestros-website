---
import '../styles/global.css';
import Button from '../components/Button.astro';
import { navItems, siteConfig, whatsappUrl } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} | ${siteConfig.tagline}`,
  description = siteConfig.description,
} = Astro.props;

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1115" />
    <link rel="icon" type="image/svg+xml" href="/ajtm-mark.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="text-ink antialiased">
    <header class="sticky top-0 z-40 border-b border-neutral-200/80 bg-white/92 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${siteConfig.name} home`}>
          <img src="/ajtm-mark.svg" alt="" class="size-10 shrink-0 rounded-lg" width="40" height="40" />
          <span class="min-w-0">
            <span class="block truncate text-sm font-black tracking-tight sm:text-base">{siteConfig.name}</span>
            <span class="hidden text-xs font-medium text-neutral-500 sm:block">{siteConfig.tagline}</span>
          </span>
        </a>

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-4 py-2 text-sm font-semibold transition',
                isActive(item.href) ? 'bg-ink text-white' : 'text-neutral-600 hover:bg-neutral-100 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex shrink-0 items-center gap-2">
          <a
            href={whatsappUrl}
            class="hidden min-h-10 items-center justify-center gap-2 rounded-full border border-neutral-200 bg-white px-4 text-sm font-semibold text-ink shadow-sm transition hover:border-[#25d366] hover:text-[#128c3a] sm:inline-flex"
            target="_blank"
            rel="noreferrer"
          >
            <span class="size-2 rounded-full bg-[#25d366]"></span>
            WhatsApp
          </a>
          <Button href="/request-quote/">Quote</Button>
        </div>
      </div>

      <nav class="flex gap-2 overflow-x-auto border-t border-neutral-200/80 px-4 py-2 lg:hidden" aria-label="Mobile navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'shrink-0 rounded-full px-3.5 py-2 text-sm font-semibold transition',
              isActive(item.href) ? 'bg-ink text-white' : 'bg-neutral-100 text-neutral-700',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main><slot /></main>

    <footer class="border-t border-neutral-200 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
        <div>
          <a href="/" class="flex items-center gap-3" aria-label={`${siteConfig.name} home`}>
            <img src="/ajtm-mark.svg" alt="" class="size-10 rounded-lg" width="40" height="40" />
            <span>
              <span class="block font-black tracking-tight">{siteConfig.name}</span>
              <span class="text-sm text-neutral-500">{siteConfig.location}</span>
            </span>
          </a>
          <p class="mt-5 max-w-md text-sm leading-6 text-neutral-600">{siteConfig.description}</p>
          <p class="mt-4 text-sm font-bold text-accent">{siteConfig.tagline}</p>
        </div>

        <div>
          <h2 class="text-sm font-black uppercase tracking-[0.18em] text-neutral-500">Pages</h2>
          <div class="mt-4 grid gap-3">
            {navItems.map((item) => <a href={item.href} class="text-sm font-semibold text-neutral-700 hover:text-accent">{item.label}</a>)}
          </div>
        </div>

        <div>
          <h2 class="text-sm font-black uppercase tracking-[0.18em] text-neutral-500">Contact</h2>
          <div class="mt-4 grid gap-3 text-sm text-neutral-600">
            <a class="font-semibold text-neutral-800 hover:text-accent" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp: {siteConfig.phone}</a>
            <a class="font-semibold text-neutral-800 hover:text-accent" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
            <span>{siteConfig.location}</span>
            <span>{siteConfig.legalName}</span>
          </div>
        </div>
      </div>
      <div class="border-t border-neutral-200 px-4 py-5 text-center text-xs font-medium text-neutral-500">
        &copy; {new Date().getFullYear()} {siteConfig.legalName}. Engineering, design, prototyping and digital fabrication.
      </div>
    </footer>

    <a
      href={whatsappUrl}
      class="fixed bottom-4 right-4 z-50 inline-flex min-h-12 items-center gap-2 rounded-full bg-[#25d366] px-4 text-sm font-black text-white shadow-xl shadow-black/20 transition hover:-translate-y-0.5 hover:bg-[#1ebe57] sm:bottom-6 sm:right-6"
      target="_blank"
      rel="noreferrer"
      aria-label="Contact AJ Tech Maestros on WhatsApp"
    >
      <span class="grid size-7 place-items-center rounded-full bg-white/20 text-xs">WA</span>
      <span>WhatsApp</span>
    </a>
  </body>
</html>
