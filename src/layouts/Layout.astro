---
import '../styles/global.css';
import Button from '../components/Button.astro';
import { navItems, siteConfig, whatsappUrl } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} | ${siteConfig.tagline}`,
  description = siteConfig.description,
} = Astro.props;

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1115" />
    <link rel="icon" type="image/svg+xml" href="/ajtm-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <div class="container-page">
      <header>
        <nav class="nav" aria-label="Main navigation">
          <a href="/" class="nav-brand" aria-label={`${siteConfig.name} home`}>
            <img src="/images/logo.png" alt={siteConfig.name} class="nav-logo" width="523" height="200" />
          </a>
          <div class="nav-links">
            {navItems.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
          <Button href={whatsappUrl}>WhatsApp Us</Button>
        </nav>
      </header>

      <main><slot /></main>

      <footer class="mt-4 border-t border-divider pt-14 pb-8">
        <div class="mb-8 grid gap-8 [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))]">
          <div>
            <div class="font-heading text-[18px] font-bold uppercase tracking-[0.02em]">{siteConfig.name}</div>
            <p class="muted mt-2 max-w-[32ch] text-[14px] leading-[1.6]">{siteConfig.tagline}<br />{siteConfig.location}.</p>
          </div>
          <div>
            <div class="kicker mb-3">Pages</div>
            <div class="flex flex-col gap-2">
              {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
            </div>
          </div>
          <div>
            <div class="kicker mb-3">Contact</div>
            <div class="flex flex-col gap-2 text-[14px]">
              <a href={whatsappUrl} target="_blank" rel="noopener">WhatsApp: {siteConfig.phoneDisplay}</a>
              <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
              <span class="muted">{siteConfig.location}</span>
            </div>
          </div>
        </div>
        <div class="border-t border-divider pt-5 text-[13px] text-[color-mix(in_srgb,var(--color-text)_60%,transparent)]">
          &copy; {new Date().getFullYear()} {siteConfig.legalName}.
        </div>
      </footer>
    </div>
  </body>
</html>
