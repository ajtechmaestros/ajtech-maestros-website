---
import Button from '../components/Button.astro';
import Layout from '../layouts/Layout.astro';
import { whatsappUrl } from '../site.config';
---

<Layout title="Thank You | AJ Tech Maestros" description="Thanks for contacting AJ Tech Maestros. We have received your inquiry and will respond with the next step.">
  <section class="pt-14 pb-20">
    <span class="kicker mb-4">Inquiry received</span>
    <h1 class="display">Thank you.</h1>
    <p class="lead mt-5">Your message has been sent. We'll review the details and respond with the right next step.</p>
    <div class="btn-row mt-8">
      <Button href={whatsappUrl}>WhatsApp Us</Button>
      <Button href="/" variant="ghost">Back Home</Button>
    </div>
  </section>
</Layout>
