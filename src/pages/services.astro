---
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Steps from '../components/Steps.astro';
import Layout from '../layouts/Layout.astro';
import { whatsappLink, whatsappMessages } from '../site.config';

const services = [
  { kicker: '3DP', title: '3D Printing From Ready Files', body: 'Send STL, OBJ, STEP or 3MF — we quote and print.' },
  { kicker: 'CAD', title: 'CAD & 3D Modelling', body: 'Sketches, measurements and ideas become manufacturable models.' },
  { kicker: 'PT', title: 'Product Prototyping', body: 'Fit checks, enclosures, functional samples, mockups.' },
  { kicker: 'RP', title: 'Replacement Parts', body: "Measure, model and reproduce the part you can't find anymore." },
  { kicker: 'ART', title: 'Custom & Branded Items', body: 'Display pieces, branded items, decor, trophies, gifts.' },
  { kicker: 'BCH', title: 'Small-Batch Production', body: 'Short runs before you commit to tooling or bigger volumes.' },
  { kicker: 'DFM', title: 'Design For Manufacture', body: 'Geometry, tolerances, materials and assembly, refined for production.' },
  { kicker: 'ENG', title: 'Engineering Support', body: 'Structured help on mechanisms, fixtures, enclosures, assemblies.' },
];

const training = [
  '3D Printing Intro',
  'CAD & Modelling',
  'Slicing & Print Prep',
  'Printer Setup',
  'Troubleshooting',
  'Design for AM',
  'Project-Based Prototyping',
];

const steps = [
  { body: 'Send your file, sketch or idea.' },
  { body: 'We review and recommend the approach.' },
  { body: 'We send a quote and timeline.' },
  { body: 'We build, finish and deliver.' },
];
---

<Layout title="Services | AJ Tech Maestros" description="3D printing, CAD modelling, prototyping, replacement parts, small-batch production, engineering support and practical digital fabrication training.">
  <PageHero label="Services" title="Sketch to finished part." description="Pick a service, or just send the problem — we'll tell you which one it needs." />

  <section class="pb-14">
    <Photo src="/images/services-banner.webp" alt="AJ Tech Maestros workshop and fabrication process" width={1200} height={800} ratio="16 / 6" eager />
  </section>

  <section class="pb-14">
    <SectionLabel />
    <div class="card-grid">
      {services.map((s) => <Card kicker={s.kicker} title={s.title}>{s.body}</Card>)}
    </div>
  </section>

  <section class="pb-14">
    <SectionLabel label="Training" title="Practical digital fabrication training." description="For individuals, teams, schools and institutions — hands-on, not theoretical." />
    <div class="flex flex-wrap gap-2.5">
      {training.map((topic) => <span class="tag tag-outline">{topic}</span>)}
    </div>
  </section>

  <section class="border-t border-divider pt-12 pb-16">
    <span class="kicker mb-5">How it works</span>
    <Steps steps={steps} />
    <div class="btn-row mt-9">
      <Button href={whatsappLink(whatsappMessages.services)}>WhatsApp Us</Button>
      <Button href="/projects/" variant="ghost">View Projects</Button>
    </div>
  </section>
</Layout>
