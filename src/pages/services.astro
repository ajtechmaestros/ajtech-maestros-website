---
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Steps from '../components/Steps.astro';
import Layout from '../layouts/Layout.astro';
import { whatsappLink, whatsappMessages } from '../site.config';

const services = [
  { kicker: '3DP', title: '3D Printing From Ready Files', body: 'Send STL, OBJ, STEP or 3MF — we quote and print.' },
  { kicker: 'CAD', title: 'CAD & 3D Modelling', body: 'Sketches, measurements and ideas become manufacturable models.' },
  { kicker: 'PT', title: 'Product Prototyping', body: 'Fit checks, enclosures, functional samples, mockups.' },
  { kicker: 'RP', title: 'Replacement Parts', body: "Measure, model and reproduce the part you can't find anymore." },
  { kicker: 'ART', title: 'Custom & Branded Items', body: 'Display pieces, branded items, decor, trophies, gifts.' },
  { kicker: 'BCH', title: 'Small-Batch Production', body: 'Short runs before you commit to tooling or bigger volumes.' },
  { kicker: 'DFM', title: 'Design For Manufacture', body: 'Geometry, tolerances, materials and assembly, refined for production.' },
  { kicker: 'ENG', title: 'Engineering Support', body: 'Structured help on mechanisms, fixtures, enclosures, assemblies.' },
];

const steps = [
  { body: 'Send your file, sketch or idea.' },
  { body: 'We review and recommend the approach.' },
  { body: 'We send a quote and timeline.' },
  { body: 'We build, finish and deliver.' },
];
---

<Layout title="Services | AJ Tech Maestros" description="3D printing, CAD modelling, prototyping, replacement parts, small-batch production and engineering support from AJ Tech Maestros.">
  <PageHero title="Sketch to finished part." description="Pick a service, or just send the problem — we'll tell you which one it needs." />

  <section class="pb-14">
    <Photo src="/images/services-banner.webp" alt="Gloved hands holding 3D-printed lattice parts" ratio="16 / 6" eager />
  </section>

  <section class="pb-14">
    <div class="card-grid">
      {services.map((s) => <Card kicker={s.kicker} title={s.title}>{s.body}</Card>)}
    </div>
  </section>

  <section class="panel-dark mb-14 grid items-center gap-6 py-11 [grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))]">
    <div>
      <span class="eyebrow">Training</span>
      <h2 class="text-[clamp(24px,3vw,32px)] tracking-[-0.01em]">Want to learn this yourself?</h2>
      <p class="mt-3.5 mb-0 max-w-[44ch] text-[15px] leading-[1.6]">The AJ Tech Academy runs hands-on digital fabrication courses for individuals, teams and institutions.</p>
    </div>
    <div><Button href="/academy/">Explore the Academy →</Button></div>
  </section>

  <section class="pb-16">
    <span class="eyebrow mb-4">How it works</span>
    <Steps steps={steps} />
    <div class="btn-row mt-9">
      <Button href={whatsappLink(whatsappMessages.services)}>WhatsApp Us</Button>
      <Button href="/projects/" variant="outline">View Projects</Button>
    </div>
  </section>
</Layout>
