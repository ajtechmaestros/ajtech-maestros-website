---
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import Layout from '../layouts/Layout.astro';
import { whatsappBase } from '../site.config';

// Ballpark pricing only — every estimate is confirmed by an engineer on WhatsApp.
// Base price is KSh per part for a simple piece; complexity scales it per preset.
const parts = [
  { id: 'bracket', label: 'Bracket', complexity: 1 },
  { id: 'gear', label: 'Gear', complexity: 1.4 },
  { id: 'enclosure', label: 'Enclosure', complexity: 1.8 },
];
const materials = [
  { id: 'PLA', basePrice: 450 },
  { id: 'PETG', basePrice: 550 },
  { id: 'ABS', basePrice: 600 },
  { id: 'Resin', basePrice: 900 },
];
const colors = [
  { id: 'White', hex: '#f4f1ea' },
  { id: 'Black', hex: '#2a2d32' },
  { id: 'Sand', hex: '#d8c3a0' },
  { id: 'Orange', hex: '#ff5a1f' },
];

const steps = [
  { title: 'Preview', body: 'Pick the closest part type and see it in your material and colour.' },
  { title: 'Estimate', body: 'Get an instant ballpark in KSh as you change material and quantity.' },
  { title: 'Confirm', body: 'Send it to WhatsApp — an engineer reviews your file and confirms the price.' },
];

const pill = 'cursor-pointer rounded-full border-[1.5px] border-line bg-white px-4 py-2 text-[14px] font-semibold text-ink transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white';
const label = 'mb-2.5 block text-[13px] font-semibold';
---

<Layout title="Get a Quote | AJ Tech Maestros" description="Preview a part in 3D, pick material, colour and quantity, get an instant ballpark price in KSh and send it to AJ Tech Maestros on WhatsApp for a confirmed quote.">
  <PageHero title="See it. Price it. Send it." description="Preview a part, choose material, colour and quantity, and get a ballpark price in seconds. Send it to WhatsApp and we'll confirm the real number." />

  <section class="pb-[72px]">
    <div id="quote-builder" class="grid items-start gap-6 lg:grid-cols-[7fr_5fr]" data-whatsapp={whatsappBase} data-parts={JSON.stringify(parts)} data-materials={JSON.stringify(materials)} data-colors={JSON.stringify(colors)}>
      <div class="flex flex-col gap-4 lg:sticky lg:top-6">
        <div class="relative overflow-hidden rounded-[24px] bg-ink" style="aspect-ratio: 4 / 3;">
          <div class="absolute inset-0 cursor-grab touch-pan-y active:cursor-grabbing" data-viewer aria-label="3D preview of the selected part. Drag to rotate." role="img"></div>
          <div class="pointer-events-none absolute top-4 left-5 text-[12px] font-bold tracking-[0.06em] text-white/45 uppercase">Live preview</div>
          <div class="pointer-events-none absolute bottom-4 left-5 text-[12px] text-white/45">Drag to rotate</div>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Sample part">
          {parts.map((part, i) => <button type="button" class={pill} data-part={part.id} aria-pressed={i === 0 ? 'true' : 'false'}>{part.label}</button>)}
        </div>
      </div>

      <div class="card flex flex-col gap-6 p-7">
        <div>
          <span class={label}>Material</span>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Material">
            {materials.map((m, i) => <button type="button" class={pill} data-material={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>{m.id}</button>)}
          </div>
        </div>

        <div>
          <span class={label}>Colour: <span class="font-bold" data-color-name>{colors[0].id}</span></span>
          <div class="flex flex-wrap gap-3" role="group" aria-label="Colour">
            {colors.map((c, i) => (
              <button
                type="button"
                class="size-10 cursor-pointer rounded-full border border-[rgba(21,23,26,0.18)] ring-offset-2 transition-shadow hover:ring-2 hover:ring-line aria-pressed:ring-2 aria-pressed:ring-accent"
                style={`background:${c.hex};`}
                data-color={c.id}
                aria-label={c.id}
                aria-pressed={i === 0 ? 'true' : 'false'}
              ></button>
            ))}
          </div>
        </div>

        <div>
          <span class={label} id="qty-label">Quantity</span>
          <div class="inline-flex items-center rounded-full border-[1.5px] border-line bg-white" role="group" aria-labelledby="qty-label">
            <button type="button" class="size-11 cursor-pointer rounded-full text-[20px] font-bold text-ink hover:text-accent" data-qty-step="-1" aria-label="Decrease quantity">−</button>
            <input type="number" min="1" max="999" value="1" inputmode="numeric" class="w-14 [appearance:textfield] bg-transparent text-center text-[16px] font-bold outline-none [&::-webkit-inner-spin-button]:appearance-none" data-qty aria-label="Quantity" />
            <button type="button" class="size-11 cursor-pointer rounded-full text-[20px] font-bold text-ink hover:text-accent" data-qty-step="1" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <div>
          <span class={label}>Your file <span class="font-normal text-subtle">(optional)</span></span>
          <label class="flex cursor-pointer flex-col items-center gap-1 rounded-[16px] border-2 border-dashed border-line bg-bg px-5 py-6 text-center transition-colors hover:border-accent data-[drag]:border-accent data-[drag]:bg-[rgba(255,90,31,0.06)]" data-dropzone>
            <input type="file" accept=".stl,.3mf" class="sr-only" data-file-input />
            <span class="text-[15px] font-bold" data-file-name>Drop your .stl or .3mf here</span>
            <span class="text-[13px] text-subtle" data-file-hint>or click to browse</span>
          </label>
          <button type="button" class="mt-2 hidden cursor-pointer text-[13px] font-semibold text-subtle hover:text-accent" data-file-clear>Remove file</button>
          <p class="mt-2 mb-0 hidden text-[13px] font-semibold text-accent-dark" data-file-error role="alert">Only .stl and .3mf files, please.</p>
        </div>

        <div class="rounded-[16px] bg-bg p-5">
          <div class="text-[12px] font-bold tracking-[0.06em] text-accent uppercase">Ballpark estimate</div>
          <div class="mt-1 text-[clamp(30px,4vw,38px)] leading-[1.15] font-extrabold tracking-[-0.02em]" data-price aria-live="polite">KSh 450</div>
          <p class="mt-1.5 mb-0 text-[13px] leading-[1.5] text-muted">An estimate only — final price is confirmed after an engineer reviews your file, size and finish.</p>
        </div>

        <button type="button" class="btn btn-primary btn-block" data-send>Send to WhatsApp for Confirmed Quote</button>
      </div>
    </div>
  </section>

  <section class="pb-[72px]">
    <span class="eyebrow">How it works</span>
    <h2 class="h2 mb-8">From preview to confirmed price.</h2>
    <Steps steps={steps} />
    <p class="mt-8 mb-0 text-[14px] text-subtle">Need CAD work, a replacement part or training instead? <a href="/request-quote/" class="link-arrow">Use the full inquiry form →</a></p>
  </section>
</Layout>

<script>
  import {
    AmbientLight, BoxGeometry, Color, CylinderGeometry, DirectionalLight, Group, Mesh,
    MeshStandardMaterial, PerspectiveCamera, Scene, WebGLRenderer,
  } from 'three';

  type Part = { id: string; label: string; complexity: number };
  type Material = { id: string; basePrice: number };
  type Swatch = { id: string; hex: string };

  const root = document.querySelector<HTMLElement>('#quote-builder')!;
  const parts: Part[] = JSON.parse(root.dataset.parts ?? '[]');
  const materials: Material[] = JSON.parse(root.dataset.materials ?? '[]');
  const colors: Swatch[] = JSON.parse(root.dataset.colors ?? '[]');

  const state = { part: parts[0], material: materials[0], color: colors[0], qty: 1, fileName: '' };

  // — 3D viewer —
  const mount = root.querySelector<HTMLElement>('[data-viewer]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scene = new Scene();
  const camera = new PerspectiveCamera(35, 4 / 3, 0.1, 100);
  camera.position.set(0, 1.6, 7.5);
  camera.lookAt(0, 0, 0);

  let renderer: WebGLRenderer | null = null;
  try {
    renderer = new WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    mount.appendChild(renderer.domElement);
  } catch {
    mount.innerHTML = '<div class="grid h-full place-items-center px-6 text-center text-[14px] text-white/60">3D preview isn’t supported in this browser — everything else still works.</div>';
  }

  scene.add(new AmbientLight(0xffffff, 0.55));
  const key = new DirectionalLight(0xffffff, 2.2);
  key.position.set(4, 6, 5);
  scene.add(key);
  const rim = new DirectionalLight(0xffb08a, 0.9);
  rim.position.set(-5, 2, -4);
  scene.add(rim);

  const material = new MeshStandardMaterial({ color: new Color(state.color.hex), roughness: 0.55, metalness: 0.05 });
  const mesh = (geometry: BoxGeometry | CylinderGeometry, x = 0, y = 0, z = 0) => {
    const m = new Mesh(geometry, material);
    m.position.set(x, y, z);
    return m;
  };

  const builders: Record<string, () => Group> = {
    bracket: () => {
      const g = new Group();
      g.add(mesh(new BoxGeometry(2.6, 0.3, 1.4), 0, -0.9, 0));
      g.add(mesh(new BoxGeometry(0.3, 2.1, 1.4), -1.15, 0.15, 0));
      // Triangular gusset approximated by a rotated box, plus mounting bosses.
      const gusset = mesh(new BoxGeometry(0.18, 1.3, 0.9), -0.62, -0.35, 0);
      gusset.rotation.z = Math.PI / 4;
      g.add(gusset);
      for (const z of [-0.4, 0.4]) {
        g.add(mesh(new CylinderGeometry(0.2, 0.2, 0.14, 24), 0.7, -0.68, z));
        const boss = mesh(new CylinderGeometry(0.2, 0.2, 0.14, 24), -0.93, 0.6, z);
        boss.rotation.z = Math.PI / 2;
        g.add(boss);
      }
      return g;
    },
    gear: () => {
      const g = new Group();
      g.add(mesh(new CylinderGeometry(1.25, 1.25, 0.5, 48)));
      g.add(mesh(new CylinderGeometry(0.45, 0.45, 0.9, 32)));
      const teeth = 18;
      for (let i = 0; i < teeth; i++) {
        const angle = (i / teeth) * Math.PI * 2;
        const tooth = mesh(new BoxGeometry(0.32, 0.5, 0.26), Math.cos(angle) * 1.38, 0, Math.sin(angle) * 1.38);
        tooth.rotation.y = -angle;
        g.add(tooth);
      }
      g.rotation.x = Math.PI / 2.6;
      return g;
    },
    enclosure: () => {
      const g = new Group();
      g.add(mesh(new BoxGeometry(2.6, 1.2, 1.8), 0, -0.25, 0));
      g.add(mesh(new BoxGeometry(2.7, 0.18, 1.9), 0, 0.55, 0));
      for (const [x, z] of [[-1.1, -0.7], [1.1, -0.7], [-1.1, 0.7], [1.1, 0.7]]) {
        g.add(mesh(new CylinderGeometry(0.09, 0.09, 0.08, 16), x, 0.68, z));
      }
      const port = mesh(new CylinderGeometry(0.16, 0.16, 0.12, 24), 1.32, -0.25, 0.3);
      port.rotation.z = Math.PI / 2;
      g.add(port);
      g.add(mesh(new BoxGeometry(0.1, 0.22, 0.5), 1.32, -0.25, -0.35));
      return g;
    },
  };

  const pivot = new Group();
  pivot.rotation.x = 0.35;
  scene.add(pivot);
  let model: Group | null = null;

  const showPart = (id: string) => {
    if (model) {
      pivot.remove(model);
      model.traverse((o) => { if (o instanceof Mesh) o.geometry.dispose(); });
    }
    model = builders[id]();
    pivot.add(model);
  };
  showPart(state.part.id);

  const resize = () => {
    if (!renderer) return;
    const { clientWidth: w, clientHeight: h } = mount;
    renderer.setSize(w, h, false);
    renderer.domElement.style.width = '100%';
    renderer.domElement.style.height = '100%';
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  };
  new ResizeObserver(resize).observe(mount);
  resize();

  // Drag to rotate; auto-rotate resumes after a short idle.
  let dragging = false;
  let lastX = 0;
  let lastY = 0;
  let lastInteraction = 0;
  mount.addEventListener('pointerdown', (e) => {
    dragging = true;
    lastX = e.clientX;
    lastY = e.clientY;
    mount.setPointerCapture(e.pointerId);
  });
  mount.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    pivot.rotation.y += (e.clientX - lastX) * 0.01;
    pivot.rotation.x = Math.max(-1.2, Math.min(1.2, pivot.rotation.x + (e.clientY - lastY) * 0.01));
    lastX = e.clientX;
    lastY = e.clientY;
    lastInteraction = performance.now();
  });
  const endDrag = () => { dragging = false; lastInteraction = performance.now(); };
  mount.addEventListener('pointerup', endDrag);
  mount.addEventListener('pointercancel', endDrag);

  let visible = true;
  new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }).observe(mount);

  let prev = performance.now();
  const tick = (now: number) => {
    const dt = Math.min((now - prev) / 1000, 0.1);
    prev = now;
    if (renderer && visible) {
      if (!dragging && !reduceMotion && now - lastInteraction > 2000) pivot.rotation.y += dt * 0.5;
      renderer.render(scene, camera);
    }
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);

  // — controls —
  const priceEl = root.querySelector<HTMLElement>('[data-price]')!;
  const qtyInput = root.querySelector<HTMLInputElement>('[data-qty]')!;
  const formatKsh = (n: number) => `KSh ${n.toLocaleString('en-KE')}`;
  const estimate = () => Math.round((state.material.basePrice * state.part.complexity * state.qty) / 10) * 10;
  const updatePrice = () => { priceEl.textContent = formatKsh(estimate()); };

  const select = (attr: string, value: string) => {
    root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));
  };

  root.querySelectorAll<HTMLElement>('[data-part]').forEach((b) => b.addEventListener('click', () => {
    state.part = parts.find((p) => p.id === b.dataset.part)!;
    select('data-part', state.part.id);
    showPart(state.part.id);
    updatePrice();
  }));
  root.querySelectorAll<HTMLElement>('[data-material]').forEach((b) => b.addEventListener('click', () => {
    state.material = materials.find((m) => m.id === b.dataset.material)!;
    select('data-material', state.material.id);
    // Resin prints read smoother and glossier than FDM plastics.
    material.roughness = state.material.id === 'Resin' ? 0.25 : 0.55;
    updatePrice();
  }));
  root.querySelectorAll<HTMLElement>('[data-color]').forEach((b) => b.addEventListener('click', () => {
    state.color = colors.find((c) => c.id === b.dataset.color)!;
    select('data-color', state.color.id);
    material.color.set(state.color.hex);
    root.querySelector('[data-color-name]')!.textContent = state.color.id;
  }));

  const setQty = (n: number) => {
    state.qty = Math.max(1, Math.min(999, Math.round(n) || 1));
    qtyInput.value = String(state.qty);
    updatePrice();
  };
  root.querySelectorAll<HTMLElement>('[data-qty-step]').forEach((b) => b.addEventListener('click', () => setQty(state.qty + Number(b.dataset.qtyStep))));
  qtyInput.addEventListener('change', () => setQty(Number(qtyInput.value)));
  qtyInput.addEventListener('input', () => {
    const n = Number(qtyInput.value);
    if (n >= 1) { state.qty = Math.min(999, Math.round(n)); updatePrice(); }
  });

  // — file dropzone (cosmetic: we only keep the name for the WhatsApp message) —
  const dropzone = root.querySelector<HTMLElement>('[data-dropzone]')!;
  const fileInput = root.querySelector<HTMLInputElement>('[data-file-input]')!;
  const fileName = root.querySelector<HTMLElement>('[data-file-name]')!;
  const fileHint = root.querySelector<HTMLElement>('[data-file-hint]')!;
  const fileClear = root.querySelector<HTMLElement>('[data-file-clear]')!;
  const fileError = root.querySelector<HTMLElement>('[data-file-error]')!;

  const setFile = (file?: File | null) => {
    const ok = !file || /\.(stl|3mf)$/i.test(file.name);
    fileError.classList.toggle('hidden', ok);
    state.fileName = file && ok ? file.name : '';
    fileName.textContent = state.fileName || 'Drop your .stl or .3mf here';
    fileHint.textContent = state.fileName ? 'Attach this file in WhatsApp when the chat opens' : 'or click to browse';
    fileClear.classList.toggle('hidden', !state.fileName);
    if (!state.fileName) fileInput.value = '';
  };
  fileInput.addEventListener('change', () => setFile(fileInput.files?.[0]));
  fileClear.addEventListener('click', () => setFile(null));
  dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.toggleAttribute('data-drag', true); });
  dropzone.addEventListener('dragleave', () => dropzone.removeAttribute('data-drag'));
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.removeAttribute('data-drag');
    setFile(e.dataTransfer?.files[0]);
  });

  // — WhatsApp handoff —
  root.querySelector('[data-send]')!.addEventListener('click', () => {
    const lines = [
      'Hello AJ Tech Maestros, I\'d like a confirmed quote for a 3D print.',
      '',
      `File: ${state.fileName || 'no file attached'}`,
      `Part: ${state.part.label}`,
      `Material: ${state.material.id}`,
      `Colour: ${state.color.id}`,
      `Quantity: ${state.qty}`,
      `Ballpark estimate: ${formatKsh(estimate())} (from the website)`,
    ];
    window.open(`${root.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });

  updatePrice();
</script>
