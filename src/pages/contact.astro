---
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { siteConfig, whatsappBase, whatsappUrl } from '../site.config';
---

<Layout title="Contact | AJ Tech Maestros" description="Contact AJ Tech Maestros on WhatsApp, by phone or email for CAD, prototyping, 3D printing and engineering support.">
  <PageHero label="Contact" title="Send the requirement first." description="A sketch, a file, dimensions or a broken part — fastest is WhatsApp. For longer briefs, use the form." />

  <section class="pb-16">
    <div class="split items-start" style="--split-a:5fr;--split-b:7fr;">
      <div class="flex flex-col gap-5">
        <Button href={whatsappUrl} block>Chat on WhatsApp</Button>
        <Card kicker="Phone / WhatsApp"><a href={whatsappBase} target="_blank" rel="noopener">{siteConfig.phoneDisplay}</a></Card>
        <Card kicker="Email"><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></Card>
        <Card kicker="Location">{siteConfig.location}</Card>
      </div>

      <form id="whatsapp-form" class="flex flex-col gap-4" data-whatsapp={whatsappBase}>
        <div class="field"><label for="c-name">Name</label><input class="input" id="c-name" name="name" type="text" placeholder="Your name" autocomplete="name" required /></div>
        <div class="field"><label for="c-contact">Phone or email</label><input class="input" id="c-contact" name="contact" type="text" placeholder="How we reach you" required /></div>
        <div class="field"><label for="c-brief">What do you need made?</label><textarea class="input" id="c-brief" name="brief" placeholder="Sketch, file, dimensions, or a short description"></textarea></div>
        <Button type="submit" class="self-start">Send via WhatsApp</Button>
        <p class="muted m-0 text-[14px]">Have files to attach or a detailed spec? <a href="/request-quote/" class="link-arrow">Use the full quote form →</a></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  // No backend: compose a pre-filled WhatsApp message from the form fields.
  const form = document.querySelector<HTMLFormElement>('#whatsapp-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? '').trim();
    const lines = [
      `Hello AJ Tech Maestros, my name is ${value('name')}.`,
      value('brief'),
      `You can reach me on: ${value('contact')}`,
    ].filter(Boolean);
    window.open(`${form.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>
