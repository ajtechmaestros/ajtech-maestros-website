---
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';
import { siteConfig, whatsappUrl } from '../site.config';
---

<Layout title="Contact | AJ Tech Maestros" description="Contact AJ Tech Maestros for engineering, CAD, prototyping, 3D printing and technical training inquiries.">
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
      <SectionHeader eyebrow="Contact" title="Tell us what you want to build." description="WhatsApp is fastest for quick questions, photos, sketches and files. Email works best for formal briefs, drawings, institutional requests and longer project notes." />

      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-[#128c3a]">WhatsApp</p>
          <h2 class="mt-3 text-2xl font-black tracking-tight">{siteConfig.phone}</h2>
          <p class="mt-3 text-sm leading-6 text-neutral-600">Best for quick quotes, file sharing, photos, dimensions and project updates.</p>
          <Button href={whatsappUrl} target="_blank" rel="noreferrer" class="mt-6">Message on WhatsApp</Button>
        </article>

        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Email</p>
          <h2 class="mt-3 break-words text-2xl font-black tracking-tight">{siteConfig.email}</h2>
          <p class="mt-3 text-sm leading-6 text-neutral-600">Useful for drawings, CAD files, purchase requests, training proposals and formal project briefs.</p>
          <Button href={`mailto:${siteConfig.email}`} variant="secondary" class="mt-6">Send Email</Button>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-panel px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeader eyebrow="Inquiry paths" title="Choose the route that matches your request" description="This keeps the useful Abe3D contact structure while aligning it with the broader AJ Tech Maestros service model." />
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Design & engineering</p><h3 class="mt-3 text-2xl font-black">CAD, product design and engineering support</h3><p class="mt-3 text-sm leading-6 text-neutral-600">For modelling, reverse engineering, drawings, assemblies, DFM and structured product-development work.</p><Button href="/request-quote/" class="mt-6">Request a Quote</Button></article>
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Fabrication</p><h3 class="mt-3 text-2xl font-black">3D printing, prototypes and custom products</h3><p class="mt-3 text-sm leading-6 text-neutral-600">For ready-to-print files, replacement parts, prototypes, short runs, branded items and custom products.</p><Button href="/request-quote/" class="mt-6">Start a Project</Button></article>
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Training & partnerships</p><h3 class="mt-3 text-2xl font-black">Technical training and collaboration</h3><p class="mt-3 text-sm leading-6 text-neutral-600">For CAD/3D-printing training, institutional workshops, collaboration and impact-project discussions.</p><Button href={`mailto:${siteConfig.email}?subject=AJ Tech Maestros training or partnership inquiry`} variant="secondary" class="mt-6">Email Inquiry</Button></article>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-black uppercase tracking-[0.18em] text-neutral-500">Location</p>
      <h2 class="mt-3 text-2xl font-black tracking-tight">{siteConfig.location}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-neutral-600">Pickup, delivery, on-site training and meetings can be arranged after the request is reviewed.</p>
    </div>
  </section>
</Layout>
