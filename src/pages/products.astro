---
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Layout from '../layouts/Layout.astro';
import { whatsappMessages } from '../site.config';

const products = [
  { image: '/images/prod-01.webp', alt: 'Replacement part', title: 'Replacement Parts', body: "The bracket, knob or clip you can't buy anymore — measured and remade." },
  { image: '/images/prod-02.webp', alt: 'Branded promotional item', title: 'Branded & Promotional Items', body: 'Keychains, badges and giveaways in your shape, your logo.' },
  { image: undefined, alt: 'Trophy or award', title: 'Trophies & Awards', body: 'One-off recognition pieces, designed around the occasion.' },
  { image: '/images/prod-04.webp', alt: 'Décor and display piece', title: 'Décor & Display Pieces', body: 'Signage, stands and display objects for home, office or event.' },
  { image: '/images/prod-05.webp', alt: 'Personalized gift item', title: 'Gifts', body: 'Personalized, printed, yours — from a name to a full custom form.' },
  { image: '/images/prod-06.webp', alt: 'Functional prototype', title: 'Functional Prototypes', body: 'Working samples for products still finding their final shape.' },
];
---

<Layout title="Products | AJ Tech Maestros" description="Made-to-order replacement parts, branded items, trophies, décor, gifts and functional prototypes from AJ Tech Maestros.">
  <PageHero label="Products" title="Made to order, not off a shelf." description="We don't stock a catalog — we print what's needed. These are the categories we produce most; tell us what you're after and we'll build it." />

  <section class="pb-16">
    <hr class="rule mb-7" />
    <div class="card-grid">
      {products.map((p, i) => (
        <Card kicker={String(i + 1).padStart(2, '0')} title={p.title}>
          <Photo slot="photo" class="card-photo" src={p.image} alt={p.alt} ratio="4 / 3" framed={false} />
          {p.body}
        </Card>
      ))}
    </div>
  </section>

  <CTASection
    title="Have something specific in mind?"
    description="Send a photo, a sketch or just a description. We'll tell you if it's a print, a prototype, or something bigger."
    whatsappMessage={whatsappMessages.product}
    secondaryHref="/contact/"
    secondaryLabel="Request a Quote"
  />
</Layout>
