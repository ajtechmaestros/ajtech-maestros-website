---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects | AJ Tech Maestros" description="Engineering, prototyping and fabrication projects by AJ Tech Maestros.">
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-[#ff7a00]">Projects</p>
    <h1 class="mt-3 max-w-4xl text-5xl font-black">Work that shows how we think, design and build.</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-white/60">This section will showcase selected CAD, prototyping, digital fabrication and product-development work as the AJ Tech Maestros portfolio grows.</p>
  </section>
</Layout>
