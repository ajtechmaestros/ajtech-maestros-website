---
import CTASection from '../components/CTASection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';

const projectWork = [
  'Design and fabrication of affordable 3D printed prosthetic and assistive devices',
  'Collaboration with clinicians, students, technical teams and community partners',
  'Training local teams in digital fabrication workflows',
  'Iterative design based on user needs and practical field feedback',
  'Regional collaboration across Kenya, Colombia, Rwanda and beyond',
];
---

<Layout title="Projects | AJ Tech Maestros" description="Selected engineering, prototyping, digital fabrication and assistive technology projects connected to AJ Tech Maestros.">
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="text-sm font-black uppercase tracking-[0.22em] text-accent">Projects</p>
      <h1 class="mt-5 max-w-5xl text-4xl font-black tracking-tight text-ink sm:text-5xl lg:text-6xl">Work that shows how we think, design and build.</h1>
      <p class="mt-6 max-w-3xl text-base leading-8 text-neutral-600 sm:text-xl">This portfolio carries forward the most relevant Abe3D project structure while creating room for broader CAD, product-development and engineering work under AJ Tech Maestros.</p>
    </div>
  </section>

  <section class="bg-panel px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
      <SectionHeader eyebrow="Featured initiative" title="Affordable Prostheses Project" description="A collaborative assistive-technology initiative that uses digital fabrication, training and partnerships to improve access to affordable prosthetic and assistive solutions." />
      <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <p class="text-sm leading-7 text-neutral-700">The project grew through collaboration with partners from Kenya, Colombia and Rwanda, including Hugo Esteban Rojas and Dr. Salsawit T. Yigrem, alongside student, clinical, technical and community collaborators.</p>
        <ul class="mt-6 grid gap-3 text-sm leading-6 text-neutral-700">
          {projectWork.map((point) => <li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent"></span><span>{point}</span></li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeader eyebrow="Portfolio structure" title="More project categories will be added as documentation is prepared" description="The old Abe3D gallery used placeholders for prototypes, printed products, workshops and assistive technology. Those categories are retained here in a cleaner engineering portfolio structure." />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {[
          ['Product prototypes', 'Enclosures, fixtures, fit checks, mechanisms and iteration-ready physical prototypes.'],
          ['Custom & functional prints', 'Replacement parts, organizers, branded products, gifts and practical printed components.'],
          ['CAD & engineering work', 'Parametric models, assemblies, reverse-engineered parts and production-oriented design work.'],
          ['Technical workshops', 'Hands-on CAD, slicing, printer operation and project-based prototyping sessions.'],
          ['Assistive technology', 'Responsibly documented prostheses and assistive technology development with relevant stakeholders.'],
          ['Small-batch production', 'Short runs used to validate products before larger production decisions.'],
        ].map(([title, copy]) => <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><h3 class="text-xl font-black">{title}</h3><p class="mt-3 text-sm leading-6 text-neutral-600">{copy}</p></article>)}
      </div>
    </div>
  </section>

  <section class="bg-panel px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl rounded-2xl border border-accent/25 bg-white p-6 shadow-sm">
      <p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Responsible development</p>
      <p class="mt-4 max-w-4xl text-base leading-7 text-neutral-700">Assistive and medical-adjacent work should be developed and evaluated with relevant technical, clinical and community stakeholders before use. AJ Tech Maestros does not treat experimental prototypes as clinically validated devices.</p>
    </div>
  </section>

  <CTASection eyebrow="Have a project?" title="Bring us the requirement, reference or prototype challenge." description="We can help identify whether the next step is CAD, reverse engineering, prototyping, 3D printing or broader engineering support." primaryHref="/request-quote/" primaryLabel="Start a Project" secondaryHref="/contact/" secondaryLabel="Contact Us" />
</Layout>
