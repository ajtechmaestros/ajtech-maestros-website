---
import Card from '../components/Card.astro';
import Corners from '../components/Corners.astro';
import CTASection from '../components/CTASection.astro';
import Photo from '../components/Photo.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Layout from '../layouts/Layout.astro';

// Add `image: '/images/port-0X.webp'` to a category once its photo is ready.
const portfolio: { title: string; body: string; image?: string }[] = [
  { title: 'Product Prototypes', body: 'Enclosures, fixtures, fit checks and mechanisms.' },
  { title: 'Custom & Functional Prints', body: 'Replacement parts, organizers and branded products.' },
  { title: 'CAD & Engineering Work', body: 'Parametric models, assemblies, reverse-engineered parts.' },
  { title: 'Technical Workshops', body: 'Hands-on CAD, slicing and project-based prototyping.' },
  { title: 'Assistive Technology', body: 'Responsibly documented, stakeholder-reviewed development.' },
  { title: 'Small-Batch Production', body: 'Short runs that validate a product before scale.' },
];
---

<Layout title="Projects | AJ Tech Maestros" description="Selected AJ Tech Maestros work: the Affordable Prostheses Project, product prototypes, CAD and engineering work, workshops and small-batch production.">
  <section class="pt-14 pb-12">
    <span class="kicker mb-4">Projects</span>
    <h1 class="display">Work that shows how we think.</h1>
  </section>

  <section class="pb-16">
    <div class="card blueprint p-6 sm:p-8">
      <Corners />
      <div class="split" style="--split-a:7fr;--split-b:5fr;">
        <div>
          <div class="card-kicker">Featured initiative</div>
          <h2 class="h2 mt-2 mb-4">Affordable Prostheses Project</h2>
          <p class="lead mb-4 max-w-none text-[16px]">3D-printed prosthetic and assistive devices, designed with clinicians and built for real-world constraints — budget, supply chains, turnaround time.</p>
          <p class="muted m-0 text-[14px] leading-[1.6]">Developed with partners across Kenya, Colombia and Rwanda — including Hugo Esteban Rojas and Dr. Salsawit T. Yigrem, alongside clinical, student and community collaborators.</p>
        </div>
        <Photo src="/images/proj-prosthetics.webp" alt="3D-printed prosthetic device" width={521} height={782} ratio="4 / 3" />
      </div>
    </div>
  </section>

  <section class="pb-14">
    <SectionLabel label="Portfolio" />
    <div class="card-grid">
      {portfolio.map((p) => (
        <Card title={p.title}>
          {p.image && <Photo slot="photo" class="card-photo" src={p.image} alt={p.title} ratio="4 / 3" framed={false} />}
          {p.body}
        </Card>
      ))}
    </div>
    <p class="muted mt-3 text-[14px] leading-[1.6]">More categories are added as documentation is prepared.</p>
  </section>

  <section class="pb-14">
    <Card kicker="Responsible development" class="p-6">
      Assistive and medical-adjacent work is developed and reviewed with clinical and community stakeholders before use. We do not treat experimental prototypes as clinically validated devices.
    </Card>
  </section>

  <CTASection
    title="Have a project?"
    description="Bring us the requirement, reference or prototype challenge — we'll find the right next step."
    secondaryHref="/contact/"
    secondaryLabel="Contact Us"
  />
</Layout>
