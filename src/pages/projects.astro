---
import CTASection from '../components/CTASection.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects | AJ Tech Maestros" description="Selected AJ Tech Maestros work, including the Affordable Prostheses Project developed with partners across Kenya, Colombia and Rwanda.">
  <PageHero title="Work that shows how we think." />

  <section class="pb-14">
    <div class="card rounded-[24px] p-6 sm:p-8">
      <div class="split gap-x-12 gap-y-8 [grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))]">
        <div>
          <span class="mb-3.5 inline-block rounded-full border border-line bg-bg px-3.5 py-1.5 text-[12px] font-bold text-accent">Featured initiative</span>
          <h2 class="mb-3.5 text-[clamp(24px,3vw,32px)] tracking-[-0.01em]">Affordable Prostheses Project</h2>
          <p class="mt-0 mb-3.5 text-[16px] leading-[1.6] text-[rgba(21,23,26,0.72)]">3D-printed prosthetic and assistive devices, designed with clinicians and built for real-world constraints — budget, supply chains, turnaround time.</p>
          <p class="m-0 text-[14px] leading-[1.6] text-[rgba(21,23,26,0.56)]">Developed with partners across Kenya, Colombia and Rwanda — including Hugo Esteban Rojas and Dr. Salsawit T. Yigrem, alongside clinical, student and community collaborators.</p>
        </div>
        <Photo class="rounded-[18px]" src="/images/proj-prosthetics.webp" alt="3D-printed prosthetic hand" ratio="4 / 3" shadow={false} />
      </div>
    </div>
  </section>

  <CTASection
    title="Have a project?"
    description="Bring us the requirement, reference or prototype challenge — we'll find the right next step."
    secondaryHref="/contact/"
    secondaryLabel="Contact Us"
  />
</Layout>
