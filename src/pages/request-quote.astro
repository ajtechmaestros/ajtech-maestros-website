---
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { whatsappUrl } from '../site.config';

const inquiryTypes = [
  '3D printing quote',
  'CAD design request',
  'Product prototyping',
  'Replacement part / reverse engineering',
  'Custom product / artwork',
  'Engineering support',
  'Technical training',
  'Partnership / project inquiry',
  'General inquiry',
];
---

<Layout title="Request a Quote | AJ Tech Maestros" description="Request a quote for CAD design, engineering, rapid prototyping, 3D printing, custom products or technical training from AJ Tech Maestros.">
  <PageHero title="Details first. Build second." description="Tell us what you want to make, repair, design, prototype or learn — attach files if you have them." />

  <section class="pb-[72px]">
    <div class="grid items-start gap-x-12 gap-y-6 lg:grid-cols-[5fr_7fr]">
      <div class="flex flex-col gap-4">
        <Button href={whatsappUrl} block>Chat on WhatsApp</Button>
        <Card lift={false} class="rounded-[16px] p-5" kicker="Specs">Dimensions, quantity, material, finish, colour and deadline where relevant.</Card>
        <Card lift={false} class="rounded-[16px] p-5" kicker="Files">STL, STEP, 3MF, OBJ, PDF, a drawing or a reference photo.</Card>
        <Card lift={false} class="rounded-[16px] p-5" kicker="Training">Audience, skill level, location, preferred format and goals.</Card>
      </div>

      <form
        name="quote-request"
        method="POST"
        action="/thank-you/"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        enctype="multipart/form-data"
        accept-charset="UTF-8"
        class="card grid gap-4 p-7 sm:grid-cols-2"
      >
        <input type="hidden" name="form-name" value="quote-request" />
        <p class="hidden"><label>Do not fill this out if you are human: <input name="bot-field" /></label></p>

        <div class="field"><label for="q-name">Name</label><input class="input" id="q-name" type="text" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="q-phone">Phone / WhatsApp</label><input class="input" id="q-phone" type="tel" name="phone" autocomplete="tel" required /></div>
        <div class="field"><label for="q-email">Email</label><input class="input" id="q-email" type="email" name="email" autocomplete="email" /></div>
        <div class="field"><label for="q-type">Inquiry type</label><select class="input" id="q-type" name="inquiry-type" required><option value="">Select inquiry type</option>{inquiryTypes.map((type) => <option value={type}>{type}</option>)}</select></div>
        <div class="field sm:col-span-2"><label for="q-message">Message / project description</label><textarea class="input" id="q-message" name="message" required></textarea></div>

        <fieldset class="field sm:col-span-2">
          <legend>Do you have a design/model already?</legend>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <label class="inline-flex items-center gap-2"><input class="accent-accent" type="radio" name="has-model" value="yes" /> Yes</label>
            <label class="inline-flex items-center gap-2"><input class="accent-accent" type="radio" name="has-model" value="no" /> No</label>
            <label class="inline-flex items-center gap-2"><input class="accent-accent" type="radio" name="has-model" value="not-applicable" /> Not applicable</label>
          </div>
        </fieldset>

        <div class="field sm:col-span-2"><label for="q-file">File upload</label><input class="input" id="q-file" type="file" name="model-file" accept=".stl,.obj,.step,.stp,.3mf,.zip,.pdf,.png,.jpg,.jpeg" /></div>
        <div class="field"><label for="q-material">Preferred material/color</label><input class="input" id="q-material" type="text" name="material-color" placeholder="PLA, PETG, black, white..." /></div>
        <div class="field"><label for="q-quantity">Quantity</label><input class="input" id="q-quantity" type="number" name="quantity" min="1" /></div>
        <div class="field"><label for="q-deadline">Deadline</label><input class="input" id="q-deadline" type="date" name="deadline" /></div>
        <div class="field"><label for="q-contact">Preferred contact method</label><select class="input" id="q-contact" name="preferred-contact"><option value="">Select preference</option><option value="whatsapp">WhatsApp</option><option value="email">Email</option><option value="phone">Phone call</option></select></div>

        <div class="sm:col-span-2"><Button type="submit">Submit Inquiry</Button></div>
      </form>
    </div>
  </section>
</Layout>
