---
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';
import Photo from '../components/Photo.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Steps from '../components/Steps.astro';
import Layout from '../layouts/Layout.astro';
import { whatsappUrl } from '../site.config';

const services = [
  { kicker: 'CAD', title: 'Product Design', body: 'Sketches become manufacturable models.' },
  { kicker: '3DP', title: '3D Printing', body: 'Functional parts, fast, in the material you need.' },
  { kicker: 'PT', title: 'Prototyping', body: 'Test fit and function before you commit to production.' },
  { kicker: 'DFM', title: 'Engineering Support', body: 'Straight answers on tolerances, materials, assembly.' },
];

const steps = [
  { title: 'Send it', body: 'A sketch, a file, a broken part.' },
  { title: 'We review', body: 'Feasibility, materials, cost — no guesswork.' },
  { title: 'We prototype', body: 'Build and test before anything scales.' },
  { title: 'We deliver', body: 'A finished part, in your hands.' },
];
---

<Layout>
  <section class="split pt-[72px] pb-14">
    <div>
      <span class="kicker mb-4">Design · Engineer · Fabricate</span>
      <h1 class="display display-xl">
        <span class="block">Ideas in.</span><span class="block">Parts out.</span>
      </h1>
      <p class="lead mt-6 max-w-[50ch] text-[18px]">CAD design, rapid prototyping and 3D printing — built around the part you actually need, not a catalog of what we can do.</p>
      <div class="btn-row mt-8">
        <Button href={whatsappUrl}>WhatsApp Us</Button>
        <Button href="/projects/" variant="ghost">See Our Work</Button>
      </div>
    </div>
    <Photo src="/images/hero-main.webp" alt="3D printer producing a honeycomb-patterned part" width={513} height={912} ratio="1 / 1" eager />
  </section>

  <section class="pt-12 pb-14">
    <SectionLabel label="01 · What we do" />
    <div class="card-grid" style="--card-min:220px;">
      {services.map((s) => <Card kicker={s.kicker} title={s.title}>{s.body}</Card>)}
    </div>
    <div class="mt-6"><a href="/services/" class="link-arrow">All services →</a></div>
  </section>

  <section class="pt-12 pb-14">
    <SectionLabel label="02 · How we work" />
    <Steps steps={steps} />
  </section>

  <section class="split pt-14 pb-16" style="--split-a:5fr;--split-b:7fr;">
    <Photo src="/images/home-impact.webp" alt="Clinician working with a patient" width={830} height={664} />
    <div>
      <span class="kicker mb-2">03 · Real-world impact</span>
      <hr class="rule mb-5" />
      <h2 class="h2 text-[clamp(26px,3vw,36px)]">Built for the clinics that need it most.</h2>
      <p class="lead mt-5 max-w-[44ch] text-[16px]">Every part starts with a patient, not a spec sheet. We work with clinicians across Kenya, Colombia and Rwanda to design hardware that fits real budgets, supply chains and timelines.</p>
      <div class="mt-5"><a href="/projects/" class="link-arrow">See the impact stories →</a></div>
    </div>
  </section>

  <CTASection
    large
    label="04 · Start a project"
    title="Got something to build?"
    description="Send a sketch, a file, or a photo of the broken part. We'll tell you the fastest way to a real one."
    secondaryHref="/contact/"
    secondaryLabel="Request a Quote"
  />
</Layout>
