---

import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Layout from '../layouts/Layout.astro';


const services = [
  { code: 'CAD', title: 'Product Design & CAD', description: 'Parametric modelling, assemblies, design refinement, reverse engineering and production drawings.' },
  { code: '3DP', title: '3D Printing', description: 'Functional parts, prototypes, replacement components, custom products and short-run production.' },
  { code: 'PT', title: 'Rapid Prototyping', description: 'Fast physical iterations to test fit, form, ergonomics and mechanisms before production.' },
  { code: 'DFM', title: 'Engineering & DFM Support', description: 'Practical engineering input on tolerances, materials, manufacturability, assembly and fabrication decisions.' },
];
---

<Layout
  title="AJ Tech Maestros | Design, Engineering, Prototyping & 3D Printing"
  description="AJ Tech Maestros helps individuals, startups and organizations turn ideas into engineered products through CAD design, rapid prototyping, 3D printing and practical engineering support."
>
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_top_right,rgba(249,115,22,0.28),transparent_34%),linear-gradient(135deg,#0f1115_0%,#111827_58%,#1f2937_100%)]"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(255,255,255,.04)_1px,transparent_1px),linear-gradient(0deg,rgba(255,255,255,.04)_1px,transparent_1px)] bg-[size:36px_36px]"></div>
    <div class="mx-auto grid min-h-[72svh] max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.12fr_.88fr] lg:px-8">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.24em] text-accent">Design • Engineering • Fabrication</p>
        <h1 class="mt-5 max-w-4xl text-5xl font-black tracking-tight sm:text-6xl lg:text-7xl">Turn ideas into engineered products.</h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-neutral-300 sm:text-xl">
          AJ Tech Maestros helps individuals teams and organizations move from concept to physical product through CAD design, rapid prototyping, 3D printing and practical engineering support.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/request-quote/" size="lg">Request a Quote</Button>
          <Button href="/services/" variant="light" size="lg">Explore Services</Button>
        </div>
      </div>


          
        

      <div class="rounded-3xl border border-white/10 bg-white/[0.06] p-7 shadow-2xl shadow-black/25 backdrop-blur">
        <img src="/ajtm-mark.svg" alt="AJ Tech Maestros" class="size-20 rounded-2xl" />
        <h2 class="mt-6 text-3xl font-black tracking-tight">Design. Engineer. Create.</h2>
        <p class="mt-4 leading-7 text-neutral-300">Built from the foundation of Abe3D, the company now combines digital fabrication with broader engineering and product-development services.</p>
        <div class="mt-7 grid grid-cols-2 gap-3 text-sm font-bold">
          <div class="rounded-2xl bg-white/10 p-4">CAD & Product Design</div>
          <div class="rounded-2xl bg-white/10 p-4">3D Printing</div>
          <div class="rounded-2xl bg-white/10 p-4">Prototyping</div>
          <div class="rounded-2xl bg-white/10 p-4">Engineering Support</div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeader
        eyebrow="What we do"
        title="From first sketch to physical part"
        description="The Abe3D commercial services have been carried forward and expanded into a broader engineering workflow for design, prototyping and fabrication."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="bg-panel px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
      <SectionHeader
        eyebrow="How we work"
        title="A practical path from problem to solution"
        description="We review the requirement first, choose the right design and fabrication path, then iterate before committing to larger production."
      />
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['01', 'Share the need', 'Send a sketch, dimensions, file, photo, broken part or project brief.'],
          ['02', 'Review & design', 'We assess feasibility, CAD requirements, materials, tolerances and production options.'],
          ['03', 'Prototype & test', 'We make and refine the part or prototype before final production where needed.'],
          ['04', 'Produce & deliver', 'We finish the agreed part, product or small batch and arrange delivery or collection.'],
        ].map(([code, title, copy]) => (
          <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-black text-accent">{code}</p>
            <h3 class="mt-2 text-xl font-black">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-neutral-600">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
    <!-- IMPACT / HUMAN ELEMENT -->
  <section class="py-20 bg-[#0d0d0d]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-[#10b981] font-bold tracking-widest text-sm mb-4 uppercase">Real-world impact</p>
        <h2 class="text-3xl font-extrabold text-white md:text-4xl mb-6">Built for the clinics that need it most.</h2>
        <p class="text-neutral-400 text-lg leading-relaxed mb-6">
          Every part we print starts with a patient, not a spec sheet. We work directly with clinicians across Kenya to design hardware that fits real constraints — budget, supply chains, and turnaround time.
        </p>
        <a href="/impact/" class="inline-flex w-fit items-center gap-2 text-[#10b981] font-semibold hover:gap-3 transition-all">
          See our impact stories →
        </a>
      </div>
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <img
          src="/images/impact.jpg"
          alt="Clinician using AJ Tech Maestros equipment"
          class="rounded-3xl shadow-2xl border border-neutral-800 w-full object-cover aspect-[4/5]"
        />
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Start a project"
    title="Have an idea, drawing, file or part you need made?"
    description="Send the requirement and AJ Tech Maestros will help determine the most practical next step."
    primaryHref="/request-quote/"
    primaryLabel="Request a Quote"
    secondaryHref="/contact/"
    secondaryLabel="Contact Us"
  />
</Layout>
