---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config';
---

<Layout>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,122,0,0.2),transparent_32%),radial-gradient(circle_at_bottom_left,rgba(6,21,47,0.8),transparent_38%)]"></div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-8 lg:py-32">
      <div>
        <p class="mb-5 text-sm font-semibold uppercase tracking-[0.25em] text-[#ff7a00]">Design • Engineering • Fabrication</p>
        <h1 class="max-w-4xl text-5xl font-black tracking-tight sm:text-6xl lg:text-7xl">
          Turn ideas into engineered products.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/65">
          AJ Tech Maestros helps individuals, startups and organizations move from concept to physical product through CAD design, rapid prototyping, 3D printing and practical engineering support.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/request-quote/" class="rounded-full bg-[#ff7a00] px-6 py-3 font-semibold text-black">Request a Quote</a>
          <a href="/services/" class="rounded-full border border-white/15 px-6 py-3 font-semibold text-white">Explore Services</a>
        </div>
      </div>

      <div class="grid content-center gap-4">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <div class="text-5xl font-black text-[#ff7a00]">AJTM</div>
          <div class="mt-3 text-2xl font-bold">{siteConfig.tagline}</div>
          <p class="mt-4 text-white/60">A broader engineering platform built from the foundation of the Abe3D project.</p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6"><div class="text-2xl font-bold">CAD</div><p class="mt-2 text-sm text-white/55">Product modelling and design for manufacture.</p></div>
          <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6"><div class="text-2xl font-bold">3D</div><p class="mt-2 text-sm text-white/55">Rapid prototyping and low-volume fabrication.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-[#ff7a00]">What we do</p>
        <h2 class="mt-3 text-4xl font-black">From concept to prototype to production.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {[
          ['Product Design & CAD', 'Parametric modelling, assemblies, design refinement and production-ready engineering drawings.'],
          ['3D Printing', 'Functional parts, prototypes, gifts, replacement components and short-run production.'],
          ['Rapid Prototyping', 'Fast iteration to test fit, form and function before committing to manufacturing.'],
          ['Engineering Support', 'Practical technical input for product development, troubleshooting and fabrication decisions.'],
        ].map(([title, copy]) => (
          <article class="rounded-3xl border border-white/10 bg-[#15181d] p-6">
            <h3 class="text-xl font-bold">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-white/60">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-[#ff7a00] p-8 text-black sm:p-12">
      <p class="text-sm font-bold uppercase tracking-[0.2em]">Have a project in mind?</p>
      <div class="mt-3 flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <h2 class="max-w-3xl text-4xl font-black">Send us the idea, drawing or broken part. We’ll help you work out the next step.</h2>
        <a href="/request-quote/" class="shrink-0 rounded-full bg-black px-6 py-3 font-semibold text-white">Start a Project</a>
      </div>
    </div>
  </section>
</Layout>
