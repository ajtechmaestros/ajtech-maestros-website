---
import CTASection from '../components/CTASection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config';
---

<Layout title="About | AJ Tech Maestros" description="About AJ Tech Maestros and ABE & JACK TECH MAESTROS LTD.">
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="text-sm font-black uppercase tracking-[0.22em] text-accent">About</p>
      <h1 class="mt-5 max-w-5xl text-4xl font-black tracking-tight text-ink sm:text-5xl lg:text-6xl">A practical engineering company built to turn ideas into working products.</h1>
      <p class="mt-6 max-w-3xl text-base leading-8 text-neutral-600 sm:text-xl">AJ Tech Maestros is the public-facing brand of {siteConfig.legalName}, combining product design, CAD, prototyping, digital fabrication and practical engineering support under one platform.</p>
    </div>
  </section>

  <section class="bg-panel px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
      <SectionHeader eyebrow="Our evolution" title="From Abe3D to a broader engineering platform" description="Abe3D established the initial digital-fabrication direction. AJ Tech Maestros keeps those capabilities while expanding beyond 3D printing into product design, engineering and technical services." />
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Foundation</p><h2 class="mt-3 text-2xl font-black">Digital fabrication</h2><p class="mt-3 text-sm leading-6 text-neutral-600">Custom 3D printing, CAD modelling, product prototyping, replacement parts, small-batch production and practical training.</p></article>
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Expansion</p><h2 class="mt-3 text-2xl font-black">Engineering & product development</h2><p class="mt-3 text-sm leading-6 text-neutral-600">A wider platform for technical design, mechanisms, reverse engineering, DFM, fabrication projects and future technology ventures.</p></article>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeader eyebrow="How we want to work" title="Practical, iterative and grounded in the requirement" description="The company is being built around useful engineering outcomes rather than technology for its own sake." />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {[
          ['Design with purpose', 'Start from the customer problem, dimensions, constraints and use case before choosing the process.'],
          ['Prototype before scaling', 'Use low-cost iteration to test fit, function and manufacturability before larger production commitments.'],
          ['Build capability', 'Use projects, documentation and training to strengthen local design and fabrication skills over time.'],
        ].map(([title, copy]) => <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><h3 class="text-xl font-black">{title}</h3><p class="mt-3 text-sm leading-6 text-neutral-600">{copy}</p></article>)}
      </div>
    </div>
  </section>

  <CTASection eyebrow="Work with us" title="Have an engineering, design or fabrication challenge?" description="Share the requirement and we will help define a practical route from idea to physical outcome." primaryHref="/request-quote/" primaryLabel="Start a Project" secondaryHref="/contact/" secondaryLabel="Contact Us" />
</Layout>
